<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Deploy Lab — Smart Deployment Platform</title>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%237c3aed'/%3E%3Cpolygon points='17 4 7 18 15 18 14 28 25 14 17 14 17 4' fill='white'/%3E%3C/svg%3E">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
--p:#7c3aed;--p2:#a78bfa;--p3:#c4b5fd;
--b:#2563eb;--b2:#60a5fa;
--g:#059669;--g2:#34d399;
--r:#dc2626;--r2:#f87171;
--o:#ea580c;--o2:#fb923c;
--bg:#f0f2f8;--card:#fff;
--t1:#0f172a;--t2:#334155;--t3:#64748b;--t4:#94a3b8;
--brd:#e2e8f0;
--glass:rgba(255,255,255,0.65);
--sh:0 4px 24px rgba(15,23,42,0.06);
--sh2:0 12px 40px rgba(15,23,42,0.1);
--sh3:0 20px 60px rgba(124,58,237,0.12);
}
html{scroll-behavior:smooth}
body{
font-family:'Plus Jakarta Sans',sans-serif;
background:var(--bg);color:var(--t1);
min-height:100vh;overflow-x:hidden;
-webkit-tap-highlight-color:transparent;
}

/* === BG === */
.page-bg{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.page-bg .g{position:absolute;border-radius:50%;filter:blur(120px);opacity:.35;animation:gMove 18s ease-in-out infinite}
.page-bg .g:nth-child(1){width:600px;height:600px;background:#c4b5fd;top:-20%;right:-15%;animation-delay:0s}
.page-bg .g:nth-child(2){width:500px;height:500px;background:#bfdbfe;bottom:-15%;left:-10%;animation-delay:-6s}
.page-bg .g:nth-child(3){width:400px;height:400px;background:#fecdd3;top:45%;left:40%;animation-delay:-12s}
@keyframes gMove{0%,100%{transform:translate(0,0) scale(1)}33%{transform:translate(50px,-40px) scale(1.1)}66%{transform:translate(-30px,30px) scale(.9)}}

/* Grain overlay */
.page-bg::after{
content:'';position:absolute;inset:0;
background:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
opacity:.5;
}

/* === COOKIE CONSENT === */
.cookie-overlay{
position:fixed;inset:0;background:rgba(15,23,42,0.4);
backdrop-filter:blur(8px);z-index:9999;
display:flex;align-items:flex-end;justify-content:center;
padding:0;
opacity:1;transition:opacity .35s ease;
}
.cookie-overlay.closing{opacity:0;pointer-events:none}
.cookie-overlay.hidden{display:none}
.cookie-box{
background:var(--card);
border-radius:24px 24px 0 0;
padding:32px 28px 36px;
max-width:520px;width:100%;
box-shadow:0 -10px 60px rgba(0,0,0,0.15);
animation:slideUp .5s cubic-bezier(.16,1,.3,1);
transition:transform .3s cubic-bezier(.4,0,.2,1),opacity .3s ease;
}
.cookie-overlay.closing .cookie-box{transform:translateY(100%);opacity:0}
.cookie-icon{display:flex;justify-content:center;margin-bottom:12px}
.cookie-icon svg{width:48px;height:48px}
.cookie-title{font-size:1.15rem;font-weight:800;margin-bottom:8px;text-align:center;color:var(--t1)}
.cookie-text{font-size:.85rem;color:var(--t3);text-align:center;line-height:1.6;margin-bottom:22px}
.cookie-btns{display:flex;gap:10px}
.cookie-btn{
flex:1;padding:14px;border:none;border-radius:14px;
font-family:inherit;font-size:.9rem;font-weight:700;
cursor:pointer;transition:all .3s cubic-bezier(.4,0,.2,1);
}
.cookie-btn.accept{
background:linear-gradient(135deg,var(--p),var(--b));color:#fff;
box-shadow:0 4px 16px rgba(124,58,237,.3);
}
.cookie-btn.accept:active{transform:scale(.96)}
.cookie-btn.decline{
background:var(--bg);color:var(--t3);border:1px solid var(--brd);
}
.cookie-btn.decline:active{transform:scale(.96)}

@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
@keyframes slideDown{from{transform:translateY(0);opacity:1}to{transform:translateY(100%);opacity:0}}

/* === CONTAINER === */
.wrap{max-width:860px;width:100%;margin:0 auto;padding:16px;position:relative;z-index:10}

/* === HEADER === */
.header{
padding:60px 0 10px;text-align:center;
animation:fadeDown .8s ease;
}
.brand{display:inline-flex;align-items:center;gap:10px;margin-bottom:6px}
.brand-mark{
width:44px;height:44px;border-radius:14px;
background:linear-gradient(135deg,var(--p),var(--b));
display:flex;align-items:center;justify-content:center;
box-shadow:0 4px 16px rgba(124,58,237,.3);
animation:logoSpin 20s linear infinite;
}
.brand-mark svg{width:24px;height:24px}
@keyframes logoSpin{0%{transform:rotate(0deg)}100%{transform:rotate(360deg)}}
.brand-name{
font-size:2rem;font-weight:800;
background:linear-gradient(135deg,var(--p),var(--b));
-webkit-background-clip:text;-webkit-text-fill-color:transparent;
background-clip:text;letter-spacing:-.5px;
}
.brand-sub{font-size:.85rem;color:var(--t4);letter-spacing:3px;text-transform:uppercase;font-weight:500}

/* === CONNECT WALLET === */
.wallet-top-bar{
position:fixed;top:0;left:0;right:0;z-index:3000;
display:flex;justify-content:flex-end;padding:12px 16px;
pointer-events:none;
}
.wallet-btn{
display:inline-flex;align-items:center;gap:8px;
padding:11px 22px;
background:linear-gradient(135deg,var(--p),var(--b));
border:none;border-radius:14px;color:#fff;
font-family:'Plus Jakarta Sans',sans-serif;font-size:.8rem;font-weight:700;
cursor:pointer;transition:all .3s;
box-shadow:0 4px 20px rgba(124,58,237,.35);
letter-spacing:.3px;pointer-events:all;
}
.wallet-btn:active{transform:scale(.96)}
.wallet-btn svg{width:17px;height:17px;flex-shrink:0}
.wallet-btn.connected{
background:linear-gradient(135deg,var(--g),var(--g2));
box-shadow:0 4px 16px rgba(5,150,105,.25);
cursor:default;
}
.wallet-modal-bg{
position:fixed;inset:0;background:rgba(15,23,42,.4);
backdrop-filter:blur(10px);z-index:8000;display:none;
align-items:center;justify-content:center;padding:16px;
}
.wallet-modal-bg.active{display:flex;animation:fadeIn .2s ease}
.wallet-modal{
background:var(--card);border-radius:22px;padding:28px 22px;
max-width:400px;width:100%;
box-shadow:var(--sh3);animation:modalPop .4s cubic-bezier(.16,1,.3,1);
}
.wallet-modal-title{font-size:1.05rem;font-weight:800;text-align:center;color:var(--t1);margin-bottom:6px}
.wallet-modal-desc{font-size:.78rem;color:var(--t3);text-align:center;margin-bottom:18px}
.wallet-option{
display:flex;align-items:center;gap:12px;
padding:14px 16px;background:var(--bg);
border:1.5px solid var(--brd);border-radius:14px;
cursor:pointer;transition:all .3s;margin-bottom:8px;
}
.wallet-option:active{transform:scale(.97);border-color:var(--p)}
.wallet-option:last-child{margin-bottom:0}
.wallet-option svg{width:28px;height:28px;flex-shrink:0}
.wallet-option-name{font-size:.85rem;font-weight:700;color:var(--t1)}
.wallet-option-sub{font-size:.65rem;color:var(--t4)}
.wallet-connecting{
display:none;text-align:center;padding:20px 0;
}
.wallet-connecting.active{display:block;animation:fadeIn .3s}
.wallet-connecting .loader{width:36px;height:36px;margin:0 auto 12px;border-width:2.5px}

@keyframes fadeDown{from{opacity:0;transform:translateY(-20px)}to{opacity:1;transform:translateY(0)}}

/* === HERO === */
.hero{
text-align:center;padding:20px 0 10px;
animation:fadeDown .8s ease .15s both;
}
.hero-headline{
font-size:1.65rem;font-weight:800;line-height:1.25;
color:var(--t1);margin-bottom:14px;
}
.hero-headline span{
background:linear-gradient(135deg,var(--p),var(--b));
-webkit-background-clip:text;-webkit-text-fill-color:transparent;
background-clip:text;
}
.hero-desc{
font-size:.92rem;color:var(--t3);line-height:1.7;
max-width:540px;margin:0 auto 24px;
}
.hero-tags{
display:flex;flex-wrap:wrap;justify-content:center;gap:8px;
margin-bottom:6px;
}
.hero-tag{
display:inline-flex;align-items:center;gap:6px;
padding:8px 16px;
background:var(--glass);backdrop-filter:blur(12px);
border:1px solid var(--brd);border-radius:30px;
font-size:.75rem;font-weight:600;color:var(--t2);
transition:all .3s;
}
.hero-tag:active{transform:scale(.96)}
.hero-tag svg{width:16px;height:16px;flex-shrink:0}
.hero-stats{
display:flex;justify-content:center;gap:28px;
margin-top:20px;padding:16px 0;
}
.hero-stat{text-align:center}
.hero-stat-num{
font-family:'JetBrains Mono',monospace;
font-size:1.3rem;font-weight:800;color:var(--p);
}
.hero-stat-label{font-size:.65rem;font-weight:600;color:var(--t4);text-transform:uppercase;letter-spacing:1px;margin-top:2px}
.live-dot{
width:7px;height:7px;border-radius:50%;
background:#22c55e;display:inline-block;
animation:livePulse 2s ease-in-out infinite;
}
@keyframes livePulse{0%,100%{opacity:1;box-shadow:0 0 0 0 rgba(34,197,94,.5)}50%{opacity:.7;box-shadow:0 0 0 4px rgba(34,197,94,0)}}
@media(max-width:600px){
.hero-headline{font-size:1.35rem}
.hero-desc{font-size:.84rem}
.hero-stats{gap:18px}
.hero-stat-num{font-size:1.1rem}
}

/* === LIVE TICKER === */
.ticker{
display:flex;gap:8px;overflow-x:auto;padding:20px 0;
-webkit-overflow-scrolling:touch;scrollbar-width:none;
animation:fadeDown .8s ease .2s both;
}
.ticker::-webkit-scrollbar{display:none}
.tick{
flex-shrink:0;
background:var(--glass);backdrop-filter:blur(16px);
border:1px solid var(--brd);border-radius:14px;
padding:10px 16px;display:flex;align-items:center;gap:8px;
transition:all .3s;
}
.tick:active{transform:scale(.96)}
.tick-name{font-size:.7rem;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.5px}
.tick-price{font-family:'JetBrains Mono',monospace;font-size:.85rem;font-weight:600;color:var(--t1)}
.tick-change{font-family:'JetBrains Mono',monospace;font-size:.72rem;font-weight:600;padding:2px 6px;border-radius:6px}
.tick-change.up{background:rgba(5,150,105,.1);color:var(--g)}
.tick-change.down{background:rgba(220,38,38,.1);color:var(--r)}

/* === MAIN CARD === */
.main{
background:var(--card);border-radius:28px;
padding:36px 28px;margin:16px 0;
box-shadow:var(--sh2);
position:relative;overflow:hidden;
animation:cardUp 1s ease .4s both;
}
.main::before{
content:'';position:absolute;top:0;left:0;right:0;height:3px;
background:linear-gradient(90deg,var(--p),var(--b),var(--g2),var(--p));
background-size:300% 100%;animation:barMove 3s linear infinite;
}
@keyframes barMove{0%{background-position:0% 0}100%{background-position:300% 0}}
@keyframes cardUp{from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:translateY(0)}}

.step-indicator{
display:flex;justify-content:center;gap:8px;margin-bottom:28px;
}
.step-dot{
width:10px;height:10px;border-radius:50%;
background:var(--brd);transition:all .4s;
}
.step-dot.active{background:var(--p);width:28px;border-radius:5px;box-shadow:0 0 12px rgba(124,58,237,.3)}

.section-title{
font-size:1.4rem;font-weight:800;text-align:center;margin-bottom:28px;
color:var(--t1);
}
.section-title em{font-style:normal;color:var(--p)}

/* === FORM === */
.field{margin-bottom:20px}
.field-label{
display:block;font-size:.72rem;font-weight:700;
color:var(--t3);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:4px;
}
.field-hint{
display:block;font-size:.78rem;color:var(--t4);margin-bottom:10px;line-height:1.4;
}
.decimals-row{display:flex;align-items:center;gap:12px}
.decimals-input{width:80px!important;text-align:center;flex-shrink:0}
.decimals-auto{font-size:.75rem;color:var(--t4);font-style:italic}

.text-input{
width:100%;padding:14px 16px;
background:var(--bg);border:1.5px solid var(--brd);
border-radius:14px;color:var(--t1);
font-family:inherit;font-size:1rem;
transition:all .3s;-webkit-appearance:none;
}
.text-input:focus{outline:none;border-color:var(--p);box-shadow:0 0 0 4px rgba(124,58,237,.08);background:#fff}
.text-input::placeholder{color:var(--t4)}

/* === NETWORK CARDS === */
.net-grid{
display:grid;grid-template-columns:repeat(3,1fr);gap:10px;
}
.net-card{
padding:16px 10px;
background:var(--bg);border:2px solid transparent;
border-radius:16px;text-align:center;
cursor:pointer;transition:all .35s cubic-bezier(.4,0,.2,1);
position:relative;overflow:hidden;
-webkit-user-select:none;user-select:none;
}
.net-card::after{
content:'';position:absolute;inset:0;
background:radial-gradient(circle at var(--x,50%) var(--y,50%),rgba(124,58,237,.08),transparent 60%);
opacity:0;transition:opacity .3s;
}
.net-card:active{transform:scale(.95)}
.net-card:active::after{opacity:1}
.net-card.selected{
border-color:var(--p);background:#fff;
box-shadow:0 0 0 3px rgba(124,58,237,.1),var(--sh);
}
.net-icon{display:flex;justify-content:center;margin-bottom:6px}
.net-icon svg{width:28px;height:28px}
.net-name{font-size:.72rem;font-weight:700;color:var(--t2);text-transform:uppercase;letter-spacing:.5px}
.net-sub{font-size:.6rem;color:var(--t4);margin-top:2px}
.net-card.selected .net-name{color:var(--p)}

/* === TOKEN AMOUNTS === */
.amount-grid{display:flex;flex-direction:column;gap:10px}
.amt-card{
display:flex;align-items:center;justify-content:space-between;
padding:18px 20px;
background:var(--bg);border:2px solid transparent;
border-radius:16px;
cursor:pointer;transition:all .35s cubic-bezier(.4,0,.2,1);
-webkit-user-select:none;user-select:none;
position:relative;overflow:hidden;
}
.amt-card::before{
content:'';position:absolute;top:50%;left:50%;
width:0;height:0;border-radius:50%;
background:rgba(124,58,237,.06);
transform:translate(-50%,-50%);
transition:width .6s,height .6s;
}
.amt-card:active::before{width:400%;height:400%}
.amt-card:active{transform:scale(.97)}
.amt-card.selected{
border-color:var(--p);background:#fff;
box-shadow:0 0 0 3px rgba(124,58,237,.1),var(--sh);
}
.amt-card.unavailable{opacity:.45;cursor:not-allowed}
.amt-card.unavailable:active{transform:none}
.amt-card.unavailable::before{display:none}

.amt-left{display:flex;align-items:center;gap:14px}
.amt-radio{
width:22px;height:22px;border-radius:50%;
border:2px solid var(--brd);
display:flex;align-items:center;justify-content:center;
transition:all .3s;flex-shrink:0;
}
.amt-card.selected .amt-radio{border-color:var(--p);background:var(--p)}
.amt-card.selected .amt-radio::after{
content:'';width:8px;height:8px;background:#fff;border-radius:50%;
animation:radioPop .3s ease;
}
@keyframes radioPop{from{transform:scale(0)}to{transform:scale(1)}}
.amt-tokens{font-size:1.1rem;font-weight:700;color:var(--t1)}
.amt-tokens small{font-size:.75rem;color:var(--t4);font-weight:500;margin-left:4px}
.amt-price{
font-family:'JetBrains Mono',monospace;
font-size:1rem;font-weight:700;color:var(--p);
}
.amt-badge{
font-size:.55rem;font-weight:700;color:var(--r);
background:rgba(220,38,38,.08);padding:3px 8px;border-radius:6px;
letter-spacing:.5px;text-transform:uppercase;margin-top:4px;
}

/* Fee info */
.fee-info{
margin-top:16px;padding:14px 18px;
background:linear-gradient(135deg,rgba(124,58,237,.04),rgba(37,99,235,.04));
border:1px solid rgba(124,58,237,.1);
border-radius:14px;text-align:center;
animation:fadeIn .3s ease;
}
.fee-info .label{font-size:.8rem;color:var(--t3);margin-bottom:4px}
.fee-info .value{
font-family:'JetBrains Mono',monospace;
font-size:1.1rem;font-weight:700;color:var(--p);
}

/* === BUTTONS === */
.btn-primary{
width:100%;padding:18px;
font-family:inherit;font-size:1.05rem;font-weight:800;
background:linear-gradient(135deg,var(--p),var(--b));
border:none;border-radius:16px;color:#fff;
cursor:pointer;position:relative;overflow:hidden;
transition:all .4s cubic-bezier(.4,0,.2,1);
margin-top:24px;
box-shadow:0 8px 28px rgba(124,58,237,.3);
letter-spacing:.5px;
display:inline-flex;align-items:center;justify-content:center;gap:8px;
}
.btn-primary:active{transform:scale(.97);box-shadow:0 4px 16px rgba(124,58,237,.25)}
.btn-primary:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn-primary .ripple{
position:absolute;border-radius:50%;
background:rgba(255,255,255,.3);
transform:scale(0);animation:ripple .6s ease-out;
pointer-events:none;
}
.btn-primary svg{width:18px;height:18px;flex-shrink:0}
@keyframes ripple{to{transform:scale(4);opacity:0}}

/* === LOADING === */
.loading{display:none;text-align:center;padding:40px 20px}
.loading.active{display:block;animation:fadeIn .3s ease}
.loader{
width:48px;height:48px;margin:0 auto 18px;
border:3px solid var(--brd);border-top-color:var(--p);
border-radius:50%;animation:spin .7s linear infinite;
position:relative;
}
.loader::after{
content:'';position:absolute;inset:5px;
border:3px solid transparent;border-top-color:var(--b2);
border-radius:50%;animation:spin 1.1s linear infinite reverse;
}
@keyframes spin{to{transform:rotate(360deg)}}
.load-text{font-size:.9rem;font-weight:600;color:var(--t3)}
.load-dots span{
display:inline-block;width:4px;height:4px;
background:var(--p);border-radius:50%;margin:0 2px;
animation:dot 1.4s ease-in-out infinite;
}
.load-dots span:nth-child(2){animation-delay:.2s}
.load-dots span:nth-child(3){animation-delay:.4s}
@keyframes dot{0%,80%,100%{transform:scale(.5);opacity:.4}40%{transform:scale(1);opacity:1}}

/* === CONTRACT COMPILE === */
.compile{display:none;animation:fadeIn .3s ease}
.compile.active{display:block}
.compile-head{
display:flex;align-items:center;gap:10px;margin-bottom:14px;
}
.compile-head svg{width:20px;height:20px;flex-shrink:0}
.compile-title{font-size:.95rem;font-weight:700;color:var(--t1)}
.compile-status{
margin-left:auto;font-size:.65rem;font-weight:700;
text-transform:uppercase;letter-spacing:1px;
padding:4px 10px;border-radius:8px;
}
.compile-status.running{color:var(--o);background:rgba(234,88,12,.08)}
.compile-status.done{color:var(--g);background:rgba(5,150,105,.08)}
.terminal{
background:#fafbfe;border-radius:16px;overflow:hidden;
box-shadow:0 2px 16px rgba(15,23,42,.08);
border:1px solid var(--brd);
}
.term-bar{
display:flex;align-items:center;gap:6px;
padding:10px 16px;background:#f1f3f9;border-bottom:1px solid var(--brd);
}
.term-dot{width:10px;height:10px;border-radius:50%}
.term-dot.r{background:#ef4444}.term-dot.y{background:#eab308}.term-dot.g{background:#22c55e}
.term-bar-title{font-family:'JetBrains Mono',monospace;font-size:.6rem;color:var(--t4);margin-left:8px}
.term-body{
padding:16px;max-height:320px;overflow-y:auto;
scrollbar-width:thin;scrollbar-color:#cbd5e1 transparent;
}
.term-body::-webkit-scrollbar{width:4px}
.term-body::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:2px}
.term-line{
font-family:'JetBrains Mono',monospace;
font-size:.65rem;line-height:1.65;color:#64748b;
white-space:pre-wrap;word-break:break-all;
animation:typeLine .1s ease;
}
.term-line .kw{color:#7c3aed}
.term-line .fn{color:#2563eb}
.term-line .str{color:#059669}
.term-line .cm{color:#94a3b8}
.term-line .ok{color:#059669;font-weight:600}
.term-line .err{color:#dc2626}
.term-line .warn{color:#d97706}
.term-line .num{color:#ea580c}
@keyframes typeLine{from{opacity:0;transform:translateX(-4px)}to{opacity:1;transform:translateX(0)}}
.compile-progress{
margin-top:14px;height:6px;background:var(--brd);
border-radius:3px;overflow:hidden;
}
.compile-bar{
height:100%;width:0;
background:linear-gradient(90deg,var(--p),var(--g2));
